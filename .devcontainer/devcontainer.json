{
  "name": "Higher-Kinded-J book",
  "build": {
    "context": "../hkj-book",
    "dockerfile": "../hkj-book/docker/Dockerfile"
  },
  "remoteUser": "node",
  "containerEnv": {
    "HKJ_BOOK_OPEN": "0",
    "HKJ_BOOK_HOST": "0.0.0.0"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Book preview", "onAutoForward": "openPreview" }
  },
  "postAttachCommand": "cd hkj-book && ./serve.sh",
  "customizations": {
    "vscode": {
      "extensions": ["yzhang.markdown-all-in-one", "davidanson.vscode-markdownlint"]
    }
  }
}
