{
  "name": "Higher-Kinded-J",
  "image": "ghcr.io/higher-kinded-j/hkj-book-toolchain:0f71b8b48a68",
  "features": {
    "ghcr.io/devcontainers/features/java:1": { "version": "25", "jdkDistro": "tem", "installGradle": false },
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "hostRequirements": { "cpus": 4, "memory": "16gb" },
  "remoteUser": "node",
  "containerEnv": {
    "LANG": "C.UTF-8",
    "HKJ_BOOK_OPEN": "0",
    "HKJ_BOOK_HOST": "0.0.0.0"
  },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": { "label": "Book preview", "onAutoForward": "notify" }
  },
  "postStartCommand": "cd hkj-book && setsid -f ./serve.sh >/tmp/hkj-book-serve.log 2>&1 </dev/null",
  "customizations": {
    "vscode": {
      "extensions": ["yzhang.markdown-all-in-one", "davidanson.vscode-markdownlint"]
    }
  }
}
