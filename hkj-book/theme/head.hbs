{{! This content will be injected into the <head> of every page }}

{{! Favicons }}
<link rel="apple-touch-icon" sizes="180x180" href="{{ path_to_root }}logos/favicon/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="{{ path_to_root }}logos/favicon/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="{{ path_to_root }}logos/favicon/favicon-16x16.png">
<link rel="manifest" href="{{ path_to_root }}logos/favicon/site.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="{{ path_to_root }}logos/favicon/android-chrome-192x192.png">
<link rel="icon" type="image/png" sizes="512x512" href="{{ path_to_root }}logos/favicon/android-chrome-512x512.png">

{{! mdBook automatically generates a <title> tag using "Chapter Title - Book Title"
    (or just "Book Title" for the main page).
    So, you usually don't need to add another <title> tag here unless you
    want to completely override mdBook's default title logic, which is complex.
    Ensure your chapter titles in SUMMARY.md and the book title in book.toml are descriptive. }}

{{! Add a meta author tag using authors from book.toml }}
{{#if book_author}}
    <meta name="author" content="{{ book_author }}">
{{else if book_authors}}
    <meta name="author" content="{{ book_authors }}">
{{/if}}

{{! Keywords for search engines. A site-wide fallback: postprocess_seo.py
    replaces it, and the meta description that index.hbs writes, with each
    page's own in CI. }}
<meta name="keywords" content="Higher-Kinded Types, Higher-Kinded-J, HKT, Java, Optics, Lens, Prism, Traversal, Iso, Affine, Focus DSL, Effect Path API, Functional Programming, Monad, Functor, Applicative, EitherPath, MaybePath, TryPath, ValidationPath, Java Records, Sealed Interface, Error Handling, Immutable Data, DTO Mapping, GenerateMapping, MapStruct Alternative, Request Validation, Spring Boot">

{{! Open Graph tags for social media sharing }}
<meta property="og:title" content="{{ title }}">
{{#if description}}
    <meta property="og:description" content="{{ description }}">
{{else}}
    <meta property="og:description" content="Unifying Composable Effects and Advanced Optics for Java. The most comprehensive functional programming library with Effect Path API, Focus DSL, compile-time DTO mapping, and code generation for Java records.">
{{/if}}
<meta property="og:type" content="website">
{{! og:url is a site-wide fallback; postprocess_seo.py rewrites it (and adds
    <link rel="canonical">) per page in CI with the real page URL. }}
<meta property="og:url" content="https://higher-kinded-j.github.io/latest/">
<meta property="og:image" content="https://higher-kinded-j.github.io/preview.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:site_name" content="Higher-Kinded-J Documentation">
<meta property="og:locale" content="en_GB">

{{! Twitter Card tags }}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
{{#if description}}
    <meta name="twitter:description" content="{{ description }}">
{{else}}
    <meta name="twitter:description" content="Unifying Composable Effects and Advanced Optics for Java. Effect Path API, Focus DSL, compile-time DTO mapping, and the most comprehensive optics implementation in the Java ecosystem.">
{{/if}}
<meta name="twitter:image" content="https://higher-kinded-j.github.io/preview.png">
<meta name="twitter:image:alt" content="Higher-Kinded-J: Composable Effects and Advanced Optics for Java">

